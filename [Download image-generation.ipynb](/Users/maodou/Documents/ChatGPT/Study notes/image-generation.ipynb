import json
import zipfile
from pathlib import Path

import torch
from PIL import Image
from IPython.display import display
from google.colab import files
from diffusers import StableDiffusionPipeline

ROOT = Path('/content/dragon-project')
BASE_MODEL = 'stable-diffusion-v1-5/stable-diffusion-v1-5'

assert torch.cuda.is_available(), "Reconnect to your GPU runtime."

# Find completed experiments instead of assuming all four finished.
experiments = [
    {'name': name}
    for name in ['A', 'B', 'C', 'D']
    if (
        ROOT / 'experiments' / name
        / 'pytorch_lora_weights.safetensors'
    ).exists()
]

if not experiments:
    raise RuntimeError(
        "No saved trained models were found. "
        "Check /content/dragon-project/experiments in Colab's Files panel."
    )

print("Completed experiments:", [e['name'] for e in experiments])

# Load the image model with memory-saving options.
image_pipe = StableDiffusionPipeline.from_pretrained(
    BASE_MODEL,
    torch_dtype=torch.float16
)
image_pipe.enable_model_cpu_offload()
image_pipe.enable_attention_slicing()
image_pipe.vae.enable_slicing()  

# Chinese-dragon prompt.
comparison_prompt = (
    "a majestic Chinese dragon, long serpentine scaled body, "
    "four clawed legs, antler-like horns, flowing whiskers, "
    "wingless, resting beside a waterfall in a misty jungle, "
    "cinematic natural history illustration, detailed creature"
)

negative = (
    "blurry, low quality, text, watermark, human, person, "
    "wings, bat wings"
)

comparison_dir = ROOT / 'comparisons'
comparison_dir.mkdir(exist_ok=True)

# Fast comparison: one image per completed experiment.
comparison_seed = 123

for config in experiments:
    name = config['name']

    image_pipe.load_lora_weights(
        str(ROOT / 'experiments' / name)
    )

    image = image_pipe(
        comparison_prompt,
        negative_prompt=negative,
        height=512,
        width=512,
        num_inference_steps=15,
        guidance_scale=7.5,
        generator=torch.Generator('cuda').manual_seed(comparison_seed)
    ).images[0]

    image.save(comparison_dir / f'{name}-seed-{comparison_seed}.png')

    print(f"Experiment {name}")
    display(image.resize((384, 384)))

    image_pipe.unload_lora_weights()

print("Choose one of the completed experiments in cell 8.")


# Generate 50 Chinese-style dragon images.

import json
from pathlib import Path
import torch
from IPython.display import display

ROOT = Path('/content/dragon-project')

completed = [
    name for name in ['A', 'B', 'C', 'D']
    if (
        ROOT / 'experiments' / name
        / 'pytorch_lora_weights.safetensors'
    ).exists()
]

if not completed:
    raise RuntimeError("No completed training experiments were found.")

print("Available experiments:", completed)

CHOSEN_EXPERIMENT = 'B'

if CHOSEN_EXPERIMENT not in completed:
    raise ValueError("Choose an experiment listed above.")

# Reuse image_pipe from the successfully completed cell 7.
image_pipe.unload_lora_weights()
image_pipe.load_lora_weights(
    str(ROOT / 'experiments' / CHOSEN_EXPERIMENT)
)
image_pipe.set_progress_bar_config(disable=True)

image_dir = ROOT / 'images'
image_dir.mkdir(parents=True, exist_ok=True)

colors = [
    'jade green',
    'copper red',
    'midnight blue',
    'pearl white',
    'amber gold'
]

habitats = [
    'a misty bamboo forest',
    'ancient moss-covered jungle ruins',
    'a waterfall surrounded by tropical plants',
    'a moonlit riverbank',
    'a fern-covered forest floor',
    'a volcanic jungle with distant glowing lava',
    'the canopy of giant rainforest trees',
    'a glowing mushroom grove',
    'a cloudy mountain forest',
    'a quiet jungle lake at dawn'
]

negative = (
    "wings, bat wings, western dragon, blurry, low quality, "
    "text, watermark, human, person, extra heads, extra legs"
)

STEPS = 25
image_log = []

for i in range(50):
    color = colors[i % len(colors)]
    habitat = habitats[i // len(colors)]

    prompt = (
        f"a majestic fictional Chinese dragon with {color} scales, "
        "a long serpentine body, four clawed legs, antler-like horns, "
        "flowing whiskers and a flowing mane, wingless, "
        f"in {habitat}, "
        "full creature visible, detailed natural history illustration, "
        "atmospheric cinematic lighting, lush jungle environment"
    )

    seed = 5000 + i
    filename = f'dragon-{i + 1:02d}.png'

    result = image_pipe(
        prompt,
        negative_prompt=negative,
        height=512,
        width=512,
        num_inference_steps=STEPS,
        guidance_scale=7.5,
        generator=torch.Generator('cuda').manual_seed(seed)
    )

    image = result.images[0]
    image.save(image_dir / filename)

    image_log.append({
        'filename': filename,
        'prompt': prompt,
        'negative_prompt': negative,
        'seed': seed,
        'experiment': CHOSEN_EXPERIMENT,
        'resolution': 512,
        'inference_steps': STEPS,
        'guidance_scale': 7.5
    })

    # Save the log after each image.
    (ROOT / 'image-generation-log.json').write_text(
        json.dumps(image_log, indent=2),
        encoding='utf-8'
    )

    print(
        f"Saved {filename} — {i + 1}/50 "
        f"(experiment {CHOSEN_EXPERIMENT}, seed {seed})",
        flush=True
    )

    # Show occasional previews.
    if i in (0, 9, 19, 29, 39, 49):
        display(image.resize((384, 384)))

print("Finished! All 50 images are saved.")
print("Run cell 9 to download the images and training evidence.")

# Download the 50 images plus generation records and comparison images.
zip_path = Path('/content/dragon-images.zip')
with zipfile.ZipFile(zip_path, 'w', zipfile.ZIP_DEFLATED) as archive:
    for image in sorted((ROOT/'images').glob('dragon-*.png')):
        archive.write(image, 'images/'+image.name)
    for name in ('image-generation-log.json','experiment-results.json','dataset-records.json'):
        archive.write(ROOT/name, name)
    for image in (ROOT/'comparisons').glob('*.png'):
        archive.write(image, 'comparisons/'+image.name)
files.download(str(zip_path))

# Keep a separate training-evidence archive: weights, logs and TensorBoard records.
evidence_path = Path('/content/dragon-training-evidence.zip')
with zipfile.ZipFile(evidence_path, 'w', zipfile.ZIP_DEFLATED) as archive:
    for item in (ROOT/'experiments').rglob('*'):
        if item.is_file(): archive.write(item, str(item.relative_to(ROOT)))
files.download(str(evidence_path))
