# Check the imports in a fresh process, as used by the training script.
import subprocess
import sys

check = subprocess.run(
    [
        sys.executable,
        "-c",
        """
from transformers import BloomPreTrainedModel, CLIPTextModel
from peft import LoraConfig
from diffusers import StableDiffusionPipeline
print("SUCCESS: image-training imports work.")
"""
    ],
    stdout=subprocess.PIPE,
    stderr=subprocess.STDOUT,
    text=True
)

print(check.stdout)

if check.returncode != 0:
    raise RuntimeError(
        "The import check still failed. Send the output printed above."
    )



experiments = [
    {'name':'A', 'size':64,  'resolution':256, 'epochs':2},
    {'name':'B', 'size':128, 'resolution':256, 'epochs':2},
    {'name':'C', 'size':128, 'resolution':512, 'epochs':2},
    {'name':'D', 'size':128, 'resolution':512, 'epochs':4},
]
results = []
for config in experiments:
    output = ROOT / 'experiments' / config['name']
    output.mkdir(parents=True, exist_ok=True)
    command = [sys.executable, '-u', str(script),
        '--pretrained_model_name_or_path='+BASE_MODEL,
        '--train_data_dir='+str(ROOT / f"data-{config['size']}"),
        '--image_column=image', '--caption_column=text',
        '--output_dir='+str(output),
        '--resolution='+str(config['resolution']),
        '--num_train_epochs='+str(config['epochs']),
        '--train_batch_size=1', '--gradient_accumulation_steps=4',
        '--gradient_checkpointing', '--mixed_precision=fp16',
        '--learning_rate=1e-4', '--lr_scheduler=constant',
        '--lr_warmup_steps=0', '--rank=4', '--seed=42',
        '--dataloader_num_workers=0', '--report_to=tensorboard',
        '--checkpointing_steps=10000', '--checkpoints_total_limit=1']
    print('Starting experiment', config, flush=True)
    started = time.time()
    with (output/'training.log').open('w') as logfile:
        process = subprocess.Popen(command, stdout=subprocess.PIPE,
                                   stderr=subprocess.STDOUT, text=True, bufsize=1)
        for line in process.stdout:
            print(line, end='', flush=True)
            logfile.write(line)
        return_code = process.wait()
    if return_code != 0:
        raise RuntimeError(f"Experiment {config['name']} failed; inspect the error above.")
    assert (output/'pytorch_lora_weights.safetensors').exists()
    results.append({**config, 'seconds':round(time.time()-started,1)})
    (ROOT/'experiment-results.json').write_text(json.dumps(results, indent=2))
print('All four training runs finished.')



