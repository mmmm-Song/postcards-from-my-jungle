import sys, json, random, time, subprocess, zipfile, gc
from pathlib import Path
from urllib.request import urlretrieve
import torch, diffusers
from datasets import load_dataset
from PIL import Image, ImageOps, ImageDraw
from IPython.display import display
from google.colab import files

assert torch.cuda.is_available(), 'Choose Runtime > Change runtime type > T4 GPU, save and reconnect.'
print('GPU:', torch.cuda.get_device_name(0))
print('Diffusers:', diffusers.__version__)

# Download the OFFICIAL training script matching your installed Diffusers release.
# Do not use the main-branch script: it may require an unreleased library version.
version = diffusers.__version__
if any(x in version for x in ('dev', '+')):
    raise RuntimeError('This notebook expects a released pip version of diffusers.')
script = Path('/content/train_text_to_image_lora.py')
url = f'https://raw.githubusercontent.com/huggingface/diffusers/v{version}/examples/text_to_image/train_text_to_image_lora.py'
urlretrieve(url, script)
print('Official training script:', url)

BASE_MODEL = 'stable-diffusion-v1-5/stable-diffusion-v1-5'
ROOT = Path('/content/dragon-project')
ROOT.mkdir(exist_ok=True)


import requests
from io import BytesIO
from requests.adapters import HTTPAdapter
from urllib3.util.retry import Retry

DATASET_ID = 'dummybrendan/animals'
ds = load_dataset(DATASET_ID, split='train')

allowed = {'lizard', 'snake', 'bat', 'owl', 'eagle', 'turtle'}
indices = [
    i for i, label in enumerate(ds['text'])
    if label.strip().lower() in allowed
]
random.Random(42).shuffle(indices)

animals = []

for idx in indices:
    try:
        row = ds[idx]
        image = ImageOps.exif_transpose(row['image']).convert('RGB')
        image.load()
    except (OSError, ValueError):
        continue

    animals.append({
        'image': image.copy(),
        'caption': f"a wildlife photograph of a {row['text']}",
        'source': {
            'type': 'real animal',
            'dataset': DATASET_ID,
            'dataset_index': idx,
            'label': row['text']
        }
    })

    if len(animals) == 96:
        break

assert len(animals) == 96, 'Not enough readable real-animal images.'


# These are artwork references, not photographs of real animals.
API = 'https://commons.wikimedia.org/w/api.php'

categories = [
    'Category:Drawings of Chinese dragons',
    'Category:Paintings of Chinese dragons',
    'Category:Dragons in art of China',
]

session = requests.Session()
session.headers.update({
    'User-Agent':
        'DragonJungleStudentProject/1.0 (educational image collection)'
})

retry = Retry(
    total=3,
    backoff_factor=2,
    status_forcelist=[429, 500, 502, 503, 504]
)
session.mount('https://', HTTPAdapter(max_retries=retry))


def meta_value(metadata, key):
    return metadata.get(key, {}).get('value', '')


dragons = []
seen = set()

for category in categories:
    continuation = {}

    while len(dragons) < 32:
        params = {
            'action': 'query',
            'format': 'json',
            'generator': 'categorymembers',
            'gcmtitle': category,
            'gcmtype': 'file',
            'gcmlimit': 10,
            'prop': 'imageinfo',
            'iiprop': 'url|extmetadata|mime|size',
            'iiurlwidth': 768,
            **continuation
        }

        response = session.get(API, params=params, timeout=60)
        response.raise_for_status()
        payload = response.json()

        if 'error' in payload:
            raise RuntimeError(payload['error'])

        pages = payload.get('query', {}).get('pages', {})

        for page in sorted(pages.values(), key=lambda x: x['title']):
            title = page['title']

            if title in seen:
                continue
            seen.add(title)

            info = page.get('imageinfo', [{}])[0]
            metadata = info.get('extmetadata', {})
            license_name = meta_value(metadata, 'LicenseShortName')

            if not any(
                name in license_name.lower()
                for name in ('public domain', 'cc0', 'cc by', 'cc-by')
            ):
                continue

            if info.get('mime') not in ('image/jpeg', 'image/png'):
                continue

            if min(info.get('width', 0), info.get('height', 0)) < 256:
                continue

            image_url = info.get('thumburl') or info.get('url')

            try:
                result = session.get(image_url, timeout=60)
                result.raise_for_status()

                image = Image.open(BytesIO(result.content))
                image = ImageOps.exif_transpose(image).convert('RGB')
                image.load()

            except (requests.RequestException, OSError, ValueError):
                continue

            dragons.append({
                'image': image.copy(),
                'caption':
                    'a depiction of a Chinese dragon, traditional dragon art',
                'source': {
                    'type': 'Chinese-dragon reference art',
                    'title': title,
                    'category': category,
                    'source_page': info.get('descriptionurl'),
                    'download_url': image_url,
                    'license': license_name,
                    'license_url': meta_value(metadata, 'LicenseUrl'),
                    'artist': meta_value(metadata, 'Artist'),
                    'credit': meta_value(metadata, 'Credit'),
                    'attribution': meta_value(metadata, 'Attribution'),
                }
            })

            print(
                f'Chinese-dragon reference {len(dragons)}/32: {title}'
            )

            if len(dragons) == 32:
                break

        if len(dragons) == 32 or 'continue' not in payload:
            break

        continuation = payload['continue']

    if len(dragons) == 32:
        break

assert len(dragons) == 32, (
    f'Only downloaded {len(dragons)}/32 dragon references. '
    'Check the network/source before training.'
)


# First 64 images: 48 animals + 16 dragons.
# All 128 images: 96 animals + 32 dragons.
records = []

for i in range(32):
    records.extend(animals[3*i:3*i+3])
    records.append(dragons[i])


for size in (64, 128):
    folder = ROOT / f'data-{size}'
    folder.mkdir(exist_ok=True)
    metadata = []

    for i, record in enumerate(records[:size]):
        filename = f'animal-{i:03d}.jpg'
        record['image'].save(folder / filename, quality=95)

        metadata.append({
            'file_name': filename,
            'text': record['caption']
        })

    (folder / 'metadata.jsonl').write_text(
        ''.join(json.dumps(row) + '\n' for row in metadata)
    )


(ROOT / 'dataset-records.json').write_text(
    json.dumps({
        'real_animal_dataset': DATASET_ID,
        'dragon_source': 'Wikimedia Commons Chinese-dragon art categories',
        'mixture': '75% real animals; 25% Chinese-dragon references',
        'records': [
            {
                'file_name': f'animal-{i:03d}.jpg',
                **record['source']
            }
            for i, record in enumerate(records)
        ]
    }, indent=2, ensure_ascii=False)
)


preview = Image.new('RGB', (4*160, 2*160))

for i, record in enumerate(records[:8]):
    preview.paste(
        ImageOps.fit(record['image'], (160, 160)),
        ((i % 4)*160, (i // 4)*160)
    )

display(preview)

print('Prepared mixed 64-image and 128-image datasets.')
print('Inspect the dragon references before running training.')

del records, animals, dragons, ds
gc.collect()


